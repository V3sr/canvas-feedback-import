{
  "manifest_version": 3,
  "name": "Canvas Feedback Import",
  "short_name": "Feedback Import",
  "version": "0.4.0",
  "description": "Import grades and written feedback to Canvas from a CSV, with a preview before anything is saved. UBC Canvas only.",
  "action": {
    "default_title": "Canvas Feedback Import",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://canvas.ubc.ca/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://canvas.ubc.ca/courses/*"
      ],
      "js": [
        "lib/csv.js",
        "lib/plan.js",
        "lib/canvas-api.js",
        "lib/apply.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css",
        "format-guide.html"
      ],
      "matches": [
        "https://canvas.ubc.ca/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
